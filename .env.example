# Copy to .env.local for local development. .env.local is git-ignored --
# never commit real secrets or endpoint URLs here.

# Set to "true" to emit X-Robots-Tag: noindex on every response
# (non-production deployments only).
DISABLE_INDEXING=false

# Book-a-demo form: where validated leads are forwarded (Formspree/Zapier/
# CRM webhook). Leaving this unset logs leads server-side instead of
# dropping them -- useful for local dev, not for production.
DEMO_REQUEST_WEBHOOK_URL=
# Optional bearer token if the webhook above requires auth.
DEMO_REQUEST_WEBHOOK_TOKEN=
